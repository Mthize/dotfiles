{
  "cli_default_open_behavior": "new_window",
  "auto_update_extensions": {
    "material-icon-theme": true,
    "mcp-server-context7": true
  },
  "gutter": { "folds": true },
  "use_system_prompts": true,
  "use_system_path_prompts": true,
  "buffer_font_weight": 400,
  "tabs": { "file_icons": true, "git_status": true },
  "title_bar": { "show_branch_status_icon": true },
  "status_bar": { "active_encoding_button": "enabled" },
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "session": { "trust_all_worktrees": false },
  "base_keymap": "Zed",
  "vim_mode": true,
  "which_key": { "enabled": true, "delay_ms": 500 },
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 15,
  "buffer_font_family": "FantasqueSansM Nerd Font Mono",
  "buffer_font_size": 15,
  "buffer_line_height": "comfortable",
  "terminal": {
    "font_family": "FantasqueSansM Nerd Font Mono",
    "font_size": 14,
    "line_height": "comfortable"
  },
  "theme": { "mode": "dark", "light": "One Light", "dark": "Tokyo Night" },
  "theme_overrides": {
    "Tokyo Night": {
      "editor.background": "#111724E6",
      "editor.gutter.background": "#111724E6",
      "editor.active_line.background": "#1A2236AA",
      "editor.line_number": "#5C677D",
      "editor.active_line_number": "#C8D3F5",
      "border": "#2A3450"
    }
  },
  "rounded_selection": true,
  "project_panel": {
    "dock": "left",
    "button": true,
    "default_width": 280,
    "indent_size": 18,
    "auto_fold_dirs": false
  },
  "agent": {
    "default_profile": "write",
    "dock": "right",
    "button": true,
    "default_width": 420
  },
  "enable_language_server": true,
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "inline_code_actions": true,
  "autosave": { "after_delay": { "milliseconds": 1500 } },
  "diagnostics": {
    "button": true,
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 80
    }
  },
  "inlay_hints": { "enabled": true },
  "semantic_tokens": "combined",
  "format_on_save": "on",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "languages": {
    "JavaScript": { "format_on_save": "on", "code_actions_on_format": { "source.fixAll.eslint": true } },
    "TypeScript": { "format_on_save": "on", "code_actions_on_format": { "source.fixAll.eslint": true } },
    "TSX": { "format_on_save": "on", "code_actions_on_format": { "source.fixAll.eslint": true } },
    "JSON": { "format_on_save": "on" }
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": { "updateImportsOnFileMove": { "enabled": "always" } },
        "javascript": { "updateImportsOnFileMove": { "enabled": "always" } }
      },
      "enable_lsp_tasks": true
    },
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayParameterNameHintsWhenArgumentMatchesName": true,
          "includeInlayFunctionParameterTypeHints": true,
          "includeInlayVariableTypeHints": true,
          "includeInlayPropertyDeclarationTypeHints": true,
          "includeInlayFunctionLikeReturnTypeHints": true,
          "includeInlayEnumMemberValueHints": true,
          "importModuleSpecifierPreference": "non-relative",
          "includePackageJsonAutoImports": "on"
        }
      }
    },
    "eslint": {
      "settings": {
        "codeActionOnSave": { "enable": true, "mode": "all" },
        "problems": { "shortenToSingleLine": true }
      }
    }
  },
  "context_servers": {
    "posthog": { "enabled": true, "url": "https://mcp.posthog.com/mcp" },
    "Neon": { "url": "https://mcp.neon.tech/mcp" }
  }
}
